# Fork-safe environment variables for deploying TrustlessEscrow.
# Copy to .env and fill in real values. Never commit .env.

# The account that deploys (and becomes the buyer). Needs Sepolia ETH.
PRIVATE_KEY=

# Sepolia RPC URL (e.g. from Alchemy/Infura/QuickNode).
SEPOLIA_RPC_URL=

# Where the deployed contract's address and transaction hash get recorded.
# Foundry writes them to broadcast/<chain-id>/DeployEscrow.s.sol/run-latest.json
# automatically during --broadcast.

# Escrow parameters.
SELLER_ADDRESS=
ARBITER_ADDRESS=
AMOUNT=          # in wei, e.g. 100000000000000000 for 0.1 ETH
DEADLINE=        # unix timestamp in seconds (block.timestamp at deploy + X)

# Required only for on-chain verification (Etherscan).
ETHERSCAN_API_KEY=

# Frontend environment variables live in frontend/.env.example
# (NEXT_PUBLIC_CHAIN, NEXT_PUBLIC_RPC_URL, NEXT_PUBLIC_ESCROW_ADDRESS).
